# NexusAI Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# APP
# ===========================================
DEBUG=true

# ===========================================
# DATABASE
# ===========================================
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./nexusai.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexusai

# ===========================================
# CHROMADB (Vector Store)
# ===========================================
# Mode: "embedded" (default) or "server"
CHROMA_MODE=embedded

# For embedded mode (local file storage)
CHROMA_DB_PATH=../chroma_db

# For server mode (remote ChromaDB instance)
# CHROMA_MODE=server
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Collection name (used in both modes)
CHROMA_COLLECTION=ksa_project

# ===========================================
# GOOGLE AI (Gemini)
# ===========================================
GOOGLE_API_KEY=your_google_api_key_here

# ===========================================
# JWT (Authentication)
# ===========================================
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRE_DAYS=7

# ===========================================
# AI MODELS
# ===========================================
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
LLM_MODEL=gemini-2.5-flash
